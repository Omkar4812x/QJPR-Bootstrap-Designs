    $("#countrycodeinputweb").autocomplete({
        source: availableCountries,
        minLength: 0,
        select: function (event, ui) {
            setTimeout(function () {
                $('#countrycodeinputweb').blur();
            }, 10);
        }
    }).click(function () {
        $(this).autocomplete("search", "");
    });

    $("#countrycodeinputmobile").autocomplete({
        source: availableCountries,
        minLength: 0,
        select: function (event, ui) {
            setTimeout(function () {
                $('#countrycodeinputmobile').blur();
            }, 10);
        }
    }).click(function () {
        $(this).autocomplete("search", "");
    });

    $.validator.addMethod("customMobileLengthChat", function (value, element) {
        var countryCode = $('form#vip_chat_form_web').find('input[name=countrycodeinput]').val();
        var maxLength = countryCodeLengths[countryCode];

        if (countryCodeLengths.hasOwnProperty(countryCode)) {
            if (maxLength !== undefined) {
                var maxLength = countryCodeLengths[countryCode];
                return this.optional(element) || value.replace(/[^\d]/g, '').length === maxLength;
            }
        }
        // If the selected country code is not in countryCodeLengths or maxLength is undefined, consider it valid
        return true;
    }, "Invalid mobile number length must be 10 digits");
    $('#vip_chat_form_web').validate(
            {// initialize the plugin

                rules: {
                    firstname: {
                        required: true
                    },
                    telephone: {
                        required: true,
                        minlength: 5,
                        maxlength: 15,
                        customMobileLengthChat: true
                    }

                },
                messages: {
                    firstname: "Please enter valid Name ",
                    telephone: "Please enter valid Mobile Number"


                },

                submitHandler: function (form, e) {
                    callAjaxRequestChat(form);
                },
            });
    // Add custom validation method
    $.validator.addMethod("customMobileLength", function (value, element) {
        var countryCode = $('form#getinvitation').find('input[name=countrycodeinputweb]').val();
        var maxLength = countryCodeLengths[countryCode];

        if (countryCodeLengths.hasOwnProperty(countryCode)) {
            if (maxLength !== undefined) {
                var maxLength = countryCodeLengths[countryCode];
                return this.optional(element) || value.replace(/[^\d]/g, '').length === maxLength;
            }
        }
        // If the selected country code is not in countryCodeLengths or maxLength is undefined, consider it valid
        return true;
    }, "Invalid mobile number length must be 10 digits");
    
    
    $("#getinvitation").validate({
        // Specify validation rules
        
        rules: {
            firstname: {
                required: true
            },
            telephone: {
                required: true,
                minlength: 5,
                maxlength: 15,
                customMobileLength: true
            },
            annual_income: {
                required: true
            },
            mother_tongue: {
                required: true
            },


        },
        messages: {
            firstname: "Please enter your name",
            telephone: "Please enter valid Mobile Number",
            annual_income: "Please enter annual income",
            mother_tongue: "Please enter mother tongue"

        },
        submitHandler: function (form, event) {
            
            if($('#countrycodeinputmobile').val()==='+91'){
                
                
            if($('#otpPinModal').length > 0){    
                 $("#otpPinModal").modal("show");
                 $('.otp_success').removeClass('d-none');
                 var dataString = {
                    "mobile":$("#telephone").val(),
                    "encryptionValue":CryptoJS.MD5($("#telephone").val()).toString(CryptoJS.enc.Hex),
                    "type":"sendOtp"
                    };
                        
                       generateRecaptchaToken('sendOtp', function(token) {
                        dataString.recaptchaToken = token;
                            
                                    
                              $.ajax({
                                url: response_url,
                                type: "POST",
                                data: JSON.stringify({'data': dataString}),
                                dataType: 'json',
                                contentType: 'application/json; charset=utf-8',
                                headers: {
                                    // 'Content-Security-Policy': "default-src 'self'",
                                    // 'Strict-Transport-Security': 'max-age=0; includeSubDomains',
                                    // 'X-Content-Type-Options': 'nosniff',
                                    // 'X-Frame-Options': 'same origin | deny',
                                    // 'X-XSS-Protection': '1; mode=block'
                                            // Add other security headers as needed
                                },
                                success: function (data, status, jqXHR) {
                                    
                                    
                                   if(jqXHR.status == 200){
                                        $('.otp_success').removeClass('d-none');
                                   }
                                     
                
                                },
                                error: function (err) {
                                    console.log("err", err);
                                },
                                 complete: function () {
                                 },
                                 done:function(){
                                     $('.otp_success').addClass('d-none');
                                 }
                              });
                              
                       });
                }else{
                    
                     if ($("#getinvitation").valid() == false) {
                        event.preventDefault();
                        return false;
                    }
        
                    if (showVipPopUpForIndianUser === '+91') {
                        $("#vipPopModal").modal("show");
                        $('.yes_call').on('click', function () {
                            $(".comments-value").val("complete");
                            $("#vipPopModal").modal("hide");
                            callAjaxRequest(form);
        
                        });
                        $('.no_call').on('click', function () {
                            $(".comments-value").val("qllead");
                            $("#vipPopModal").modal("hide");
                            callAjaxRequestNo(form);
                        });
                    } else {
                        $("#thankYouModal").modal("show");
                        callAjaxRequest(form);
                       
                    }
                    
                }
            }
            else {
                $("#thankYouModal").modal("show");
                callAjaxRequest(form);
            } 
        }
              
    });
    
   // Handle main form button click
    $(".get_invited_vip_page").click(function() {        
        if ($("#getinvitation").valid()) {
             if($('#countrycodeinputmobile').val()==='+91'){
                $('#otpPinModal').modal();
             }else{
                 
                 var form = $('form#getinvitation');

                   if ($("#getinvitation").valid() == false) {
                        event.preventDefault();
                        return false;
                    }
        
                    if (showVipPopUpForIndianUser === '+91') {
                        $("#vipPopModal").modal("show");
                        $('.yes_call').on('click', function () {
                            $(".comments-value").val("complete");
                            $("#vipPopModal").modal("hide");
                            callAjaxRequest(form);
        
                        });
                        $('.no_call').on('click', function () {
                            $(".comments-value").val("qllead");
                            $("#vipPopModal").modal("hide");
                            callAjaxRequestNo(form);
                        });
                    } else {
