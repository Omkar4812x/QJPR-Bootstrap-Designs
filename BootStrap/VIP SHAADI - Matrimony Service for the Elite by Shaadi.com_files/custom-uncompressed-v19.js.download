function callAjaxRequestChat(form) {


    let data = $(form).serializeArray().reduce((o, p) => ({...o, [p.name]: p.value}), {});

    let dataToBeShare = {};
    let extension;
    let firstname;
    for (const [key, value] of Object.entries(data)) {

        if (key == 'countrycodeinput') {
            extension = value;
        }

        dataToBeShare[key] = value;
        if (key == 'telephone') {
            dataToBeShare[key] = extension + '-' + value;
        }

        if (key == 'firstname') {
            firstname = value.substring(0, 100);
            dataToBeShare['firstname'] = firstname;
        }
    }

    $("#vipChatErrorWeb").html('');
    $.ajax({
        url: ajaxcallurl,
        type: "POST",
        data: JSON.stringify({'data': dataToBeShare}),
        dataType: 'json',
        contentType: 'application/json; charset=utf-8',
        async: false,
        headers: {
            'Content-Security-Policy': "default-src 'self'",
            'Strict-Transport-Security': 'max-age=0; includeSubDomains',
            'X-Content-Type-Options': 'nosniff',
            'X-Frame-Options': 'same origin | deny',
            'X-XSS-Protection': '1; mode=block'
                    // Add other security headers as needed
        },

        success: function (response) {

            let message = response.message;
            if (message === "Your enquiry is already registered with us ") {
                $('.register_user_chat').removeClass('d-none');
            } else {
                $('.register_user_chat').addClass('d-none');
                $('form#vip_chat_form_web').trigger("reset"); //Line1

                $("#thankYouWeb").css({'opacity': '1',
                    'height': 'auto'});

                $("#formDetailsWeb").css({'display': 'none'});

            }



        },
        error: function (err) {
            console.log("123", err)
        }
    });
}

