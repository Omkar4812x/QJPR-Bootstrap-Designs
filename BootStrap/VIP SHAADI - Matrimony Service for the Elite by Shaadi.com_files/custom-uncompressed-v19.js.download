    var timer;
    var duration = 120; // 5 minutes in seconds

    function manageTimer(action) {
     var timeRemaining = duration;

        function updateDisplay(seconds) {
            var minutes = Math.floor(seconds / 60);
            var secs = seconds % 60;
            $('#timer-otp').text(minutes + ':' + (secs < 10 ? '0' : '') + secs);
        }

        if (action === 'start') {
            updateDisplay(timeRemaining);
            timer = setInterval(function() {
                timeRemaining--;
                updateDisplay(timeRemaining);
                if (timeRemaining <= 0) {
                    clearInterval(timer);
                     $('.otp_submit').prop('disabled', true);
                     $('.resend_otp_link').removeClass('d-none'); 
                }
            }, 1000);
        } else if (action === 'stop') {
            clearInterval(timer);
            updateDisplay(duration); // Reset display to initial duration
        }else if (action === 'reset') {
                    clearInterval(timer);
                    timeRemaining = duration;
                    updateDisplay(timeRemaining);
                    timer = setInterval(function() {
                        timeRemaining--;
                        updateDisplay(timeRemaining);
                        if (timeRemaining <= 0) {
                            clearInterval(timer);
                             $('.otp_submit').prop('disabled', true);
                             $('.resend_otp_link').removeClass('d-none'); 
                        }
                    }, 1000);
        }
    }

            // Bootstrap modal events
    $('#otpPinModal').on('shown.bs.modal', function () {
        manageTimer('start');
    });

    $('#otpPinModal').on('hidden.bs.modal', function () {
        manageTimer('stop');
    });
    
    $('.resend_otp_link').on('click',function(){
        
          manageTimer('reset');
      
        //   $('.otp_success').addClass('show-animation');
           var dataString = {
                "mobile":$("#telephone").val(),
                "encryptionValue":CryptoJS.MD5($("#telephone").val()).toString(CryptoJS.enc.Hex),
                "type":"sendOtp",
                };
                    
        generateRecaptchaToken('resend_otp', function(token) {
            dataString.recaptchaToken = token;

            $.ajax({
                url: response_url,
                type: "POST",
                data: JSON.stringify({ 'data': dataString }),
                dataType: 'json',
                contentType: 'application/json; charset=utf-8',
                headers: {
                    // 'Content-Security-Policy': "default-src 'self'",
                    // 'Strict-Transport-Security': 'max-age=0; includeSubDomains',
                    // 'X-Content-Type-Options': 'nosniff',
                    // 'X-Frame-Options': 'same origin | deny',
                    // 'X-XSS-Protection': '1; mode=block'
                },
                success: function (data, status, jqXHR) {
                    if (jqXHR.status == 200) {
                        $(".resend_otp_link").addClass('d-none');
                        $(".otp_success").removeClass('d-none');
                        $('.otp_submit').prop('disabled', false);
                    }
                },
                error: function (err) {
                    if (err.status == 400) {
                        $(".otp_invalid").removeClass('d-none');
                    }
                    console.log("err", err);
                },
                complete: function () {
                    // Any cleanup or final steps
                }
            });
        }); 
        
    });
    
  let otpForm = document.querySelector('.otp_form');
  
  if(otpForm !=null){
    for(let pin of otpForm.children) {
        pin.onkeypress = function(event) {
                     // Allow only numeric input
                     let charCode = (event.which) ? event.which : event.keyCode;
                     if (charCode < 48 || charCode > 57) {
                         event.preventDefault();
                     }
                 };
         pin.onkeyup = function(event) {
             // Check if the input is a numeric character
             if (pin.value.match(/^[0-9]$/)) {
                 // Move focus to the next input field if it exists
                 if (pin.nextElementSibling) {
                     pin.nextElementSibling.focus();
                 }
             } else {
                 // Clear the input if it is not a numeric character
                 pin.value = '';
             }
         };
         pin.onkeydown = function(event) {
            // Check if the pressed key is backspace
            if (event.keyCode === 8) {
                // Clear the current input field if it's empty
                if (pin.value === '' && pin.previousElementSibling) {
                    pin.previousElementSibling.focus();
                    pin.previousElementSibling.value = ''; // Clear previous input field too
                }
            }
        };
    }
  }
  
  
     function generateRecaptchaToken(action, callback) {
        grecaptcha.ready(function() {
            grecaptcha.execute('6Le5k9cpAAAAAIP3edICjJlvQT3seR-H1Hygv6Dl', { action: action }).then(function(token) {
                if (typeof callback === 'function') {
                    callback(token);
                } else {
                    console.error('Callback is not a function');
                }
            });
        });
    }
    
});

function alignModal() {
    var modalDialog = $(this).find(".modal-dialog");

    // Applying the top margin on modal to align it vertically center
    modalDialog.css("margin-top", Math.max(0, ($(window).height() - modalDialog.height()) / 2));
}
// Align modal when it is displayed
$(".modal").on("shown.bs.modal", alignModal);

// Align modal when user resize the window
$(window).on("resize", function () {
    $(".modal:visible").each(alignModal);
});

