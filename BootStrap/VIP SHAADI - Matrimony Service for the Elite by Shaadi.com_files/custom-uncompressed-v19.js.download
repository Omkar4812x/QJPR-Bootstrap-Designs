};
var shouldAbort = false;

function test() {
//    
//    if (shouldAbort) {
//        console.log('Aborted. Do not schedule the next execution.');
//        return;
//    }

    var form = $('form#getinvitation');
    var micrositelogid = form.find('input[name=microsite_log]').val();
    var firstname = form.find('input[name=firstname]').val();
    var countrycode = form.find('input[name=countrycodeinputweb]').val();
    var phoneNo = form.find('input[name=telephone]').val();
    var login = form.find('input[name=login]').val();
    var source = form.find('input[name=source]').val();
    const phoneNumberLength = countryCodeLengths[countrycode] || '6,15';

    const phoneRegx = new RegExp(`^[0-9_\\-+()\\* ]{${phoneNumberLength}}$`, 'i');
    var countrycodeRegx = /[+][0-9]{1,3}$/gm;

    if (firstname && countrycode && phoneNo) {
        if (!countrycodeRegx.test(countrycode) || !phoneRegx.test(phoneNo)) {
//            shouldAbort = true; // Set to true if validation fails
//            console.log("shouldAbort in validation",shouldAbort);
            console.log('Validation failed. Aborting the AJAX call.');
             // Schedule the next execution after 20 seconds
            setTimeout(test, 20000);
            return 1;
        } 
            var dataString = {
                "telephone": countrycode + '-' + phoneNo,
                "comments": 'incomplete',
                "login": login,
                "source": source,
                "micrositelogid": micrositelogid,
                "firstname": firstname.substring(0, 100)
            };
            $.ajax({
                url: ajaxcallurl,
                type: "POST",
                data: JSON.stringify({'data': dataString}),
                dataType: 'json',
                contentType: 'application/json; charset=utf-8',
                headers: {
                    'Content-Security-Policy': "default-src 'self'",
                    'Strict-Transport-Security': 'max-age=0; includeSubDomains',
                    'X-Content-Type-Options': 'nosniff',
                    'X-Frame-Options': 'same origin | deny',
                    'X-XSS-Protection': '1; mode=block'
                            // Add other security headers as needed
                },
                success: function (data, status, jqXHR) {

                    if (jqXHR.status === 200) {
                        shouldAbort = true;
                        console.log('Specific response received. AJAX request may be aborted.');

//                    if (data.message === 'Your Incomplete Leads is Already registered ') {
//                        shouldAbort = true;
//                        console.log('Specific response received. AJAX request may be aborted.');
//                    }
//                    if (data.message === 'Your enquiry is already registered with us ') {
//                        shouldAbort = true;
//                        console.log('Specific response received. AJAX request may be aborted.');
//                    }

                        console.log("response", data);
                    }
                },
                error: function (err) {
                    console.log("err", err);
                },
                complete: function () {
                    // Schedule the next execution after 20 seconds
                    setTimeout(function () {
                        if (!shouldAbort) {
                            test();
                        } else {
                            console.log('Aborted. Do not schedule the next execution.');
                        }
                    }, 20000);
                }
            });
        
    } else {
        // Schedule the next execution after 20 seconds
        setTimeout(test, 20000);
    }

}

// Initial call to start the process
test();