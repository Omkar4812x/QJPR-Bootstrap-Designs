function lettersOnly(input) {
    var regex = /[^a-z'\s]/gi;
    input.value = input.value.replace(regex, "");
}

function AllowNumber(e, oField)
{
    var keynum;
    var keychar;
    var numcheck;


    if (window.event) // IE
    {
        keynum = e.keyCode;
    } else if (e.which) // Netscape/Firefox/Opera
    {
        keynum = e.which;
    }

    if (keynum > 31 && (keynum < 48 || keynum > 57)) {
        return false;
    }
    return true;
}


$(function () {
    $(window).scroll(function () {
        if ($(this).scrollTop() > 50) {

            $('.header').addClass("header_active");
        }
        if ($(this).scrollTop() < 50) {

            $('.header').removeClass("header_active");
        }
    })

});



$('.layer_close').on("click", function () {
    
    $("#thankYouModal,#vipPopModal").modal("hide");
});



function callAjaxRequest(form) {

    let data = $(form).serializeArray().reduce((o, p) => ({...o, [p.name]: p.value}), {});

    let dataToBeShare = {};
    let extension;
    let firstname;
    for (const [key, value] of Object.entries(data)) {

        if (key == 'countrycodeinputweb') {
            extension = value;
        }

        dataToBeShare[key] = value;
        if (key == 'telephone') {
            dataToBeShare[key] = extension + '-' + value;
        }
        if (key == 'firstname') {
            firstname = value.substring(0, 100);
            dataToBeShare['firstname'] = firstname;
        }
        if (key == 'mother_tongue') {
            dataToBeShare['mother_tongue'] = value;
        }
        if (key == 'annual_income') {
            dataToBeShare['annual_income'] = value;
        }

    }


    $.ajax({
        url: ajaxcallurl,
        type: "POST",
        data: JSON.stringify({'data': dataToBeShare}),
        dataType: 'json',
        contentType: 'application/json; charset=utf-8',
        async: false,
        headers: {
            'Content-Security-Policy': "default-src 'self'",
            'Strict-Transport-Security': 'max-age=0; includeSubDomains',
            'X-Content-Type-Options': 'nosniff',
            'X-Frame-Options': 'same origin | deny',
            'X-XSS-Protection': '1; mode=block'
                    // Add other security headers as needed
        },

        success: function (response) {

            let message = response.message;
            if (message === "Your enquiry is already registered with us ") {
                $('.register_user').removeClass('d-none');
                $('#thankYouModal').modal("hide");
            } else {
                $('.register_user').addClass('d-none');
                $('#thankYouModal').modal("show");
             
            }
               $('form#getinvitation').trigger("reset"); //Line1

        },
        error: function (err) {
            console.log("123", err)
        }
    });
}

